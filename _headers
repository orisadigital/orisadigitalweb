# Cloudflare Pages reads this at deploy time.
#
# The HTML is revalidated every time so a deploy goes live immediately, while
# the assets — which are only ever replaced under a new filename — are cached
# for a year. That makes a repeat visit cost one small HTML request instead of
# re-downloading the hero video.

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

/image/*
  Cache-Control: public, max-age=31536000, immutable

/video/*
  Cache-Control: public, max-age=31536000, immutable

/styles.css
  Cache-Control: public, max-age=3600

/main.js
  Cache-Control: public, max-age=3600
